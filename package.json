{
  "name": "webtechpros",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "vite --host 0.0.0.0",
    "content": "node server/content-server.mjs",
    "start": "STATIC_DIR=dist node server/content-server.mjs",
    "admin:password": "node server/content-server.mjs set-password",
    "setup:helpdesk": "node scripts/setup-helpdesk.mjs",
    "build": "tsc -b && vite build",
    "build:examples": "node scripts/examples/build.mjs",
    "build:logo": "node scripts/brand/build-logo-pack.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
