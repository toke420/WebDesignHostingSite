# Merge into the HTTPS server block managed by Virtualmin for webtechpros.net.
# Point the domain's document root at the built dist/ directory.
# Helpdesk must run persistently on 127.0.0.1:8080 and the content server on
# 127.0.0.1:8090 (see README).
location / {
    try_files $uri $uri/ /index.html;
}
# Website editor. The page itself is static; it talks to the content server below.
location = /admin {
    return 301 /admin/;
}
location /admin/ {
    try_files $uri /admin/index.html;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "no-cache" always;
}
# Content server (Node, 127.0.0.1:8090): live content, admin API and uploaded images.
location = /api/content {
    proxy_pass http://127.0.0.1:8090;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}
location /api/admin/ {
    proxy_pass http://127.0.0.1:8090;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 9m;
}
location = /sitemap.xml {
    proxy_pass http://127.0.0.1:8090;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}
location = /blog/rss.xml {
    proxy_pass http://127.0.0.1:8090;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}
location /uploads/ {
    proxy_pass http://127.0.0.1:8090;
    proxy_set_header Host $host;
}
# Example concept sites are static; keep them out of search results.
location /examples/ {
    add_header X-Robots-Tag "noindex" always;
}
location = /widget.js {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}
location /api/widget/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
}
# Staff inbox: configure a separate HTTPS helpdesk subdomain in Virtualmin.
# Proxy ALL paths on that subdomain to 127.0.0.1:8080 using the same headers,
# proxy_buffering off, HTTP/1.1 and read timeout above. Do not expose /api/auth,
# /api/settings or other staff endpoints on the main site by accident.
