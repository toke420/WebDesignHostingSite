# Production only. Store the real file outside the public document root, mode 600.
CONTENT_ADDR=127.0.0.1:8090
# Persistent folder for published content, drafts, history and uploaded images. Back it up.
CONTENT_DATA_DIR=/home/webtechpros/content-data
# Marks the admin session cookie Secure. Keep true behind HTTPS.
CONTENT_SECURE_COOKIE=true
# Optional: initial admin password, only read when no password exists yet.
# Prefer leaving this empty and running `npm run admin:password` once instead.
ADMIN_PASSWORD=
