# Production only. Store the real file outside the public document root, mode 600.
HELPDESK_ADDR=127.0.0.1:8080
HELPDESK_BASE_URL=https://helpdesk.webtechpros.net
HELPDESK_ALLOWED_ORIGINS=https://webtechpros.net,https://www.webtechpros.net
HELPDESK_DATA_DIR=/home/webtechpros/helpdesk-data
# Only enable after verifying the local reverse proxy sets trustworthy forwarding headers.
HELPDESK_TRUST_PROXY=true
# Set a real operator email and unique strong password securely before first start.
HELPDESK_ADMIN_EMAIL=
HELPDESK_ADMIN_PASSWORD=
# Optional email delivery and offline enquiry notifications. Populate securely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=
