[Unit]
Description=WebTechPros content server (/admin editor)
After=network.target

[Service]
Type=simple
# Replace paths and user with your site's dedicated deployment account.
User=webtechpros
WorkingDirectory=/home/webtechpros/app
EnvironmentFile=/home/webtechpros/content.env
ExecStart=/usr/bin/node /home/webtechpros/app/server/content-server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
